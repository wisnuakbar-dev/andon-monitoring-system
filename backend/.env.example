# Database - NeonDB
# DATABASE_URL = koneksi pooled (nama host: ...-pooler.neon.tech)
# DIRECT_URL    = koneksi direct (hapus bagian -pooler dari host)
# Ambil keduanya dari Neon dashboard: Project > Connection Details
DATABASE_URL="postgresql://USER_PLACEHOLDER:PASSWORD@ep-XXXX-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER_PLACEHOLDER:PASSWORD@ep-XXXX.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Server
PORT=3000
NODE_ENV="development"

# Client
CLIENT_URL="http://localhost:5173"

# JWT - generate secret: openssl rand -hex 32
JWT_SECRET="dev-only-secret-ganti-di-produksi"
JWT_EXPIRES_IN="1d"

# MQTT (broker untuk MQTT Ingest - topik andon/simulator)
MQTT_BROKER_URL="wss://test.mosquitto.org:8081/mqtt"
MQTT_TOPIC="andon/simulator"

# Analytics - zona waktu untuk pengelompokan per hari pada /api/analytics/summary
ANALYTICS_TIMEZONE="Asia/Jakarta"

# Realtime (Socket.IO) - broadcast KPI terbaru setiap ada data baru dari MQTT Ingest
SOCKET_PATH="/socket.io"
SOCKET_PING_INTERVAL=25000
SOCKET_PING_TIMEOUT=20000

# Realtime - jeda (ms) penggabungan burst pesan MQTT sebelum KPI di-broadcast
KPI_BROADCAST_DEBOUNCE_MS=500
# Rentang default (hari) KPI yang di-broadcast, dan jumlah log terbaru pada payload
KPI_RANGE_DAYS=7
KPI_RECENT_LOGS=10